# Password for the admin panel and /api/admin/* endpoints (HTTP Basic auth, username "admin"). Required.
ADMIN_PASSWORD=

# Token clients must send as "Authorization: Bearer <token>" to use the proxy. Required.
AUTHORIZATION_TOKEN=

# Set to "false" to run without Redis: keys are read from TYPESAFE_API_KEYS, and request counters,
# cooldowns and check results stay in each instance's memory. Defaults to "true".
# USE_REDIS=true

# Keys used when USE_REDIS=false: one per line (or separated by commas), or JSONL lines as exported
# from the admin panel. The admin panel cannot add, import or delete keys in this mode.
# TYPESAFE_API_KEYS=

# Upstash Redis REST credentials, found in the Upstash console. Added automatically on Vercel
# when the database is connected. Required unless USE_REDIS=false.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Prefix for all Redis keys. Use a different value to keep local data apart from production. Defaults to "jev:".
# REDIS_KEY_PREFIX=jev:

# Port for the local dev server (dev.ts only; ignored on Vercel). Defaults to 3000.
PORT=3000
